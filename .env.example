# Copy to .env and fill in. Never commit .env.

# Which version of the site to run. Restart `npm run dev` / rebuild after changing.
#   v0 = public waitlist (emails are saved and shown in /admin)
#   v1 = Amazon-only brand site
#   v2 = direct store (cart, Razorpay checkout, accounts)
SITE_VERSION=v0

# Admin login for /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Signs admin and customer sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Razorpay → Account & Settings → API Keys (use Test Mode keys while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Razorpay → Webhooks. URL: https://your-domain/api/webhooks/razorpay
# Events: order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Development only: adds "Simulate successful / failed payment" buttons at checkout
# that settle orders without Razorpay. Ignored when using live (rzp_live_) keys.
# TEST_PAYMENTS=true

# The site's public address, used in password-reset emails.
# In production this must be your real domain, e.g. https://bittertruth.coffee
# PUBLIC_URL=http://localhost:5173

# Email (password resets) via https://resend.com — verify your domain there first.
# Without these, reset links are printed in the server terminal instead of emailed.
# RESEND_API_KEY=
# EMAIL_FROM=Bitter Truth Coffee <orders@your-domain.com>

# Shipping charge in paise (₹1 = 100). 9000 = ₹90.
# Leave unset to show checkout as not configured and charge ₹0.
SHIPPING_PAISE=9000

# true limits checkout to NCR PIN codes. false accepts any valid Indian PIN.
# Restart the server after changing. Anything other than false stays on NCR.
NCR_ONLY=true

# Cash on delivery. Payment stays pending until you mark it collected in the admin.
COD_ENABLED=true

# Manual UPI. Leave blank to hide it. A customer reference never marks an order paid.
# UPI_VPA=yourname@upi
# UPI_PAYEE_NAME=Bitter Truth Coffee

# Optional copy of each order email.
# ADMIN_NOTIFY_EMAIL=owner@yourdomain.com
# SUPPORT_EMAIL=hello@yourdomain.com

# Free waitlist database. Supabase → Project Settings → API.
# Use the service_role key here. Never prefix it with VITE_.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Optional
# PORT=4000
# DATA_DIR=data          # where store.db and uploaded images are kept
