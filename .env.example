# Copy to .env and fill in. Never commit .env.

# Which version of the site to run:
#   v1 = Amazon-only brand site (default) · v2 = direct store (cart, Razorpay checkout, accounts)
# Restart `npm run dev` / rebuild after changing.
SITE_VERSION=v1

# Admin login for /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Signs admin and customer sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Razorpay → Account & Settings → API Keys (use Test Mode keys while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Razorpay → Webhooks. URL: https://your-domain/api/webhooks/razorpay
# Events: order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Development only: adds "Simulate successful / failed payment" buttons at checkout
# that settle orders without Razorpay. Ignored when using live (rzp_live_) keys.
# TEST_PAYMENTS=true

# The site's public address, used in password-reset emails.
# In production this must be your real domain, e.g. https://bittertruth.coffee
# PUBLIC_URL=http://localhost:5173

# Email (password resets) via https://resend.com — verify your domain there first.
# Without these, reset links are printed in the server terminal instead of emailed.
# RESEND_API_KEY=
# EMAIL_FROM=Bitter Truth Coffee <orders@your-domain.com>

# Optional
# PORT=4000
# DATA_DIR=data          # where store.db and uploaded images are kept
